# /etc/systemd/system/crsw-promoter.timer  (internal VM only)
#   sudo systemctl enable --now crsw-promoter.timer
#   journalctl -u crsw-promoter.service   # one JSON line per action
[Unit]
Description=Run the CRSW deposit promoter every five minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
