# /etc/systemd/system/crsw-promoter.service  (internal VM only)
# One promoter run. Triggered by crsw-promoter.timer; never enabled on
# its own. WorkingDirectory is the checkout holding the compose file and
# .env.promoter. Edit it if the checkout is elsewhere.
[Unit]
Description=CRSW deposit promoter (one run)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/crsw-data-promoter
# flock: a slow run must never overlap the next timer tick.
ExecStart=/usr/bin/flock -n /run/lock/crsw-promoter.lock \
  /usr/bin/docker compose -f deploy/compose.yaml --profile internal run --rm promoter
# Exit 1 means "something was refused", which is worth seeing in the
# journal but is not a service failure.
SuccessExitStatus=1
