# Copy to .env and fill in. .env is gitignored.
# Local dev: the access key / secret of a key that can write ONLY under staging/.
CRSW_S3_ENDPOINT=https://rgw.ceph.er.kcl.ac.uk
CRSW_S3_ACCESS_KEY=
CRSW_S3_SECRET_KEY=
CRSW_S3_BUCKET=crsw
CRSW_STAGING_PREFIX=staging/_test

# placeholder (local dev, identity = CRSW_DEV_USER) or proxy (production
# behind the KCL reverse proxy, which does sign-in and group restriction).
CRSW_AUTH_MODE=placeholder
CRSW_DEV_USER=k1078591

# proxy mode. The header name is discovered on first deploy: set
# CRSW_DEBUG_HEADERS=1, GET /auth/headers through the proxy, read the
# header carrying the signed-in user, set it here, unset the flag.
CRSW_PROXY_USER_HEADER=
CRSW_PROXY_GROUPS_HEADER=
CRSW_PROXY_REQUIRED_GROUP=er_prj_kdl_slavery
# Optional regex with one group, e.g. ^([a-z]\d+)@kcl\.ac\.uk$ to keep the k-number.
CRSW_PROXY_USERNAME_PATTERN=
# The proxy's load-balancer ranges, comma-separated. Used by nginx (allow/deny)
# and by the app. Empty = accept from anywhere (local dev only).
CRSW_TRUSTED_PROXY_CIDRS=
CRSW_DEBUG_HEADERS=0

# Limits (bytes). Blank = unlimited.
CRSW_MAX_BODY_BYTES=5368709120
CRSW_USER_QUOTA_BYTES=
CRSW_USER_MAX_OPEN_DEPOSITS=5
CRSW_MAX_MEMBERS_PER_DEPOSIT=10000

# compose only
CRSW_HTTP_PORT=8080
CRSW_MAX_BODY=5g
