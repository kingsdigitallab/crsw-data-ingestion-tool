# Copy to .env and fill in. .env is gitignored.
# Local dev: the access key / secret of a key that can write ONLY under staging/.
CRSW_S3_ENDPOINT=https://rgw.ceph.er.kcl.ac.uk
CRSW_S3_ACCESS_KEY=
CRSW_S3_SECRET_KEY=
CRSW_S3_BUCKET=crsw
# staging/_test was the laptop-era prefix (to 19 October 2026); both VMs
# and the promoter use staging since then.
CRSW_STAGING_PREFIX=staging

# placeholder (local dev, identity = CRSW_DEV_USER) or proxy (production
# behind the KCL reverse proxy, which does sign-in and group restriction).
# Placeholder is for a laptop only: on the VM every deposit would be
# attributed to CRSW_DEV_USER.
CRSW_AUTH_MODE=placeholder
CRSW_DEV_USER=k1078591

# proxy mode. The KCL proxy forwards the signed-in user as x-webauth-user
# (observed at /auth/headers on 16 October 2026), the display name as
# x-webauth-name and the address as x-webauth-mail. Header names are
# case-insensitive. The username is lower-cased and must be a plain key
# segment (letters, digits, . _ -); the name is shown on pages only, never
# written to a record, label or audit line (blank = show the k-number only);
# the mail header is deliberately unused. A new proxy would be checked the
# same way: CRSW_DEBUG_HEADERS=1, GET /auth/headers through it, unset.
CRSW_PROXY_USER_HEADER=x-webauth-user
CRSW_PROXY_NAME_HEADER=x-webauth-name
# No groups header is forwarded (16 October 2026); leave blank.
CRSW_PROXY_GROUPS_HEADER=
CRSW_PROXY_REQUIRED_GROUP=er_prj_kdl_slavery
# Optional regex with one group, e.g. ^([a-z]\d+)@kcl\.ac\.uk$ to keep the
# k-number. Not needed for x-webauth-user, which is already the bare k-number.
CRSW_PROXY_USERNAME_PATTERN=
# The proxy's load-balancer ranges, comma-separated. Used by nginx (allow/deny)
# and by the app. Empty = accept from anywhere (local dev only).
CRSW_TRUSTED_PROXY_CIDRS=
CRSW_DEBUG_HEADERS=0

# Limits (bytes). Blank = unlimited.
CRSW_MAX_BODY_BYTES=5368709120
CRSW_USER_QUOTA_BYTES=
# How often the running service re-fetches the vocabulary from its
# repository, in seconds (default 600). 0 = only at start-up.
CRSW_VOCAB_REFRESH_SECONDS=600
CRSW_USER_MAX_OPEN_DEPOSITS=5
CRSW_MAX_MEMBERS_PER_DEPOSIT=10000

# The read role: find, browse and download datasets (finding-and-reuse.md).
# Off unless both read keys are set. On the web VM this MUST be the
# read-scoped key issued by eResearch (index/ plus the four strand
# prefixes, no staging/). A personal key here is for a laptop only: it
# can write anywhere, and the service is wrapped so it never will, but it
# must not sit on the VM.
CRSW_READ_S3_ACCESS_KEY=
CRSW_READ_S3_SECRET_KEY=
# Where the promoter writes datasets.jsonl (PROMOTER_INDEX_PREFIX), and how
# often the service re-reads it, in seconds.
CRSW_INDEX_PREFIX=index
CRSW_INDEX_REFRESH_SECONDS=60
# Who may download amber data: off (listed, not served; the page names the
# steward), groups (members of CRSW_AMBER_GROUP_TEMPLATE for the strand, as
# the proxy's groups header reports; needs CRSW_PROXY_GROUPS_HEADER), all
# (any signed-in member). A Centre policy decision; off until it is made.
CRSW_AMBER_ACCESS=off
CRSW_AMBER_GROUP_TEMPLATE=er_prj_kdl_slavery_{strand}
# r12: the (CD)ISaW explorer. When set, centre/cdisaw datasets get an
# "Explore this data in (CD)ISaW" link on their page and Find data row,
# to <url>/#datasets=<slug>. Blank = no link.
# e.g. CRSW_CDISAW_URL=https://cdisaw.sites.er.kcl.ac.uk
CRSW_CDISAW_URL=
# placeholder mode only: groups the fixed dev user is in, comma-separated.
CRSW_DEV_GROUPS=
# "Search by meaning or content", through the KCL LLM platform
# (finding-and-reuse.md §5 and §7). Set URL and key both or neither; needs
# the read role. On the VM use a key issued to the project, not a person.
# The embedding model ranks dataset descriptions (and, with CRSW_PASSAGES,
# passages) against the words typed; the reranker reads the top twenty;
# the chat model answers "Why this?" on a click and nothing else on the
# web (the question-to-filter step on the find page was retired on
# 22 October 2026). What is sent: the words typed, titles and abstracts,
# passages of files whose sensitivity allows it. Never a whole file.
CRSW_LLM_BASE_URL=
CRSW_LLM_API_KEY=
# Each step is switched off by blanking its model name.
CRSW_LLM_CHAT_MODEL=arc:lite
# The embed alias resolves to a backend on the platform; vectors made
# with another backend are never ranked, and the page says so until the
# promoter has rewritten them. arc:embed (Qwen3-Embedding, text only) on
# both VMs since 16 October 2026: arc:embedvl scored every pair of texts
# alike (docs/web-deposit/query-instruction-handoff.md). Must match
# PROMOTER_LLM_EMBED_MODEL.
CRSW_LLM_EMBED_MODEL=arc:embed
# Off on the web VM since 16 October 2026: arc:rerankvl (vision-language)
# ranked text worse than the embedding alone. A line set to blank is off; no
# line at all means the built-in default, which is on.
CRSW_LLM_RERANK_MODEL=
# Vector length; must match PROMOTER_LLM_EMBED_DIMS.
CRSW_LLM_EMBED_DIMS=1024
# Put in front of a question before it is embedded, in the model's own
# "Instruct: ...\nQuery: ..." form; the stored vectors never carry it,
# so changing it is a restart, not a re-embed. Unset = the default
# ("Given a web search query, retrieve relevant passages that answer the
# query"); blank = off, the question goes bare.
#CRSW_LLM_QUERY_INSTRUCTION=
CRSW_LLM_TIMEOUT_SECONDS=20
# Which sensitivities' abstracts (and passages, below) may be sent
# (comma-separated, from green,amber). Green only until the Centre allows
# amber.
CRSW_LLM_SENSITIVITIES=green
# The weak band on the search page (docs/web-deposit/weak-band-handoff.md):
# a passage found by meaning alone shows as strong only when it is within
# BAND of the best meaning score and scores at least FLOOR; the rest fold
# under "more passages, close in meaning only". Chosen 19 October 2026 for
# arc:embed at 1024 numbers (a control query's best was 0.31, the wanted
# results 0.41 and up); a different embedding model moves the floor.
# FLOOR=0 switches the floor off.
CRSW_SEARCH_WEAK_BAND=0.10
CRSW_SEARCH_WEAK_FLOOR=0.35
# Searching inside documents (finding-and-reuse.md §7): 1 = keep a copy of
# the promoter's passages (index/passages/) on the VM and offer /search.
# A passage is shown only to someone the download rule (CRSW_AMBER_ACCESS)
# would let fetch its file. The copy lives at the path below, on the
# `passages` volume in deploy/compose.yaml; delete it to rebuild.
CRSW_PASSAGES=0
CRSW_PASSAGES_PATH=/data/passages.duckdb

# compose only
CRSW_HTTP_PORT=8080
CRSW_MAX_BODY=5g
