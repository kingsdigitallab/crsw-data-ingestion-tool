# Copy to .env and fill in. .env is gitignored.
# For local dev, take the access key / secret from the [k1078591] stanza
# in %APPDATA%\rclone\rclone.conf (this is a stand-in for the staging-only key).
CRSW_S3_ENDPOINT=https://rgw.ceph.er.kcl.ac.uk
CRSW_S3_ACCESS_KEY=
CRSW_S3_SECRET_KEY=
CRSW_S3_BUCKET=crsw
CRSW_STAGING_PREFIX=staging/_test
CRSW_AUTH_MODE=placeholder
