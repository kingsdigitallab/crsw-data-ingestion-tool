{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRSW dataset record",
  "description": "Schema 0.7 (r11). Records marked 0.5 and 0.6 are still accepted and upgraded on read: 0.5's derived_from is a string that becomes a list of references; 0.6's domain is a string that becomes a one-element list, and its free-text spatial moves to spatial_note. Tools write 0.7.",
  "type": "object",
  "required": ["schema_version", "dataset_uuid", "identifier", "strand",
               "domain", "project", "dataset", "state", "sensitivity",
               "temporal", "version", "abstract", "subject",
               "created", "modified", "files"],
  "properties": {
    "schema_version": {"enum": ["0.5", "0.6", "0.7"]},
    "dataset_uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "identifier": {"type": "string", "pattern": "^(rs1|rs2|rs3|rs4|centre)/[a-z0-9-]+/(green|amber)/(0_raw|1_interim|2_final)/[a-z0-9-]+$"},
    "strand": {"enum": ["rs1", "rs2", "rs3", "rs4", "centre"]},
    "domain": {
      "oneOf": [
        {"type": "string", "description": "0.6 form, read and upgraded, never written"},
        {"type": "array", "items": {"type": "string"}, "minItems": 1,
         "description": "domain codes, primary first (r11)"}
      ]
    },
    "project": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "dataset": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "state": {"enum": ["0_raw", "1_interim", "2_final"]},
    "sensitivity": {"enum": ["green", "amber"]},
    "temporal": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string"},
        "end": {"type": "string"}
      }
    },
    "version": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
    "abstract": {"type": "string"},
    "subject": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "vocabulary_version": {"type": "string"},
    "creator": {"type": "string"},
    "source_type": {"enum": ["archive", "survey", "scrape", "instrument", "partner", "derived", "other"]},
    "source_detail": {"type": "string"},
    "provider": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
                 "description": "slugs from the vocabulary's providers list (r11)"},
    "license": {"type": "string"},
    "steward": {"type": "string"},
    "depositors": {"type": "array", "items": {"type": "string"}},
    "created": {"type": "string"},
    "modified": {"type": "string"},
    "derived_from": {
      "oneOf": [
        {"type": "string", "description": "0.5 form, read and upgraded, never written"},
        {"type": "array", "items": {"$ref": "#/definitions/reference"}}
      ]
    },
    "provenance": {"type": "array", "items": {"$ref": "#/definitions/activity"}},
    "category_history": {"type": "array", "items": {"$ref": "#/definitions/history_entry"}},
    "language": {"type": "array", "items": {"type": "string"}},
    "ethics_ref": {"type": "string"},
    "spatial": {
      "oneOf": [
        {"type": "string", "description": "0.6 form, read and upgraded into spatial_note, never written"},
        {"type": "array", "items": {"type": "string", "pattern": "^(m49:[0-9]{3}|iso:[A-Z]{2})$"},
         "description": "place codes from places.json: UN M49 nodes and ISO 3166 alpha-2 countries (r11)"}
      ]
    },
    "spatial_note": {"type": "string"},
    "notes": {"type": "string"},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "checksum_sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024,
                   "not": {"pattern": "(^|/)dataset\\..*\\.json$"},
                   "pattern": "^[^/].*[^/]$|^[^/]$"},
          "checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "temporal": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "string"},
              "end": {"type": "string"}
            }
          },
          "format": {"type": "string"},
          "derived_from": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  },
  "definitions": {
    "reference": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["dataset", "external"]},
        "identifier": {"type": "string", "pattern": "^(rs1|rs2|rs3|rs4|centre)/[a-z0-9-]+/(green|amber)/(0_raw|1_interim|2_final)/[a-z0-9-]+$"},
        "dataset_uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "version": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
        "url": {"type": "string"},
        "citation": {"type": "string"},
        "retrieved": {"type": "string"}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "dataset"}}, "required": ["identifier"]},
        {"properties": {"kind": {"const": "external"}}, "anyOf": [{"required": ["url"]}, {"required": ["citation"]}]}
      ]
    },
    "activity": {
      "type": "object",
      "required": ["activity"],
      "properties": {
        "activity": {"type": "string"},
        "description": {"type": "string"},
        "tool": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string"},
            "repo": {"type": "string"},
            "commit": {"type": "string"},
            "version": {"type": "string"},
            "command": {"type": "string"},
            "notebook": {"type": "string"}
          }
        },
        "inputs": {"type": "array", "items": {"anyOf": [{"type": "string"}, {"$ref": "#/definitions/reference"}]}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "agent": {"type": "string"},
        "started": {"type": "string"},
        "ended": {"type": "string"}
      }
    },
    "history_entry": {
      "type": "object",
      "required": ["when", "by", "kind"],
      "properties": {
        "when": {"type": "string"},
        "by": {"type": "string"},
        "kind": {"enum": ["added", "removed", "replaced", "split_review", "domain_changed", "field_set"]},
        "field": {"type": "string"},
        "from": {"type": "array", "items": {"type": "string"}},
        "to": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"},
        "vocabulary_version": {"type": "string"}
      },
      "if": {"properties": {"kind": {"const": "field_set"}}, "required": ["kind"]},
      "then": {"required": ["field"]}
    }
  }
}
