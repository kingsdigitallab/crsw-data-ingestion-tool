# Promoter configuration. Copy to .env.promoter (gitignored) and fill in.
# This key can write to the dataset prefixes; it must NEVER be given to
# the web service, and this file must never be present on the web VM.
PROMOTER_S3_ENDPOINT=https://rgw.ceph.er.kcl.ac.uk
PROMOTER_S3_ACCESS_KEY=
PROMOTER_S3_SECRET_KEY=
PROMOTER_S3_BUCKET=crsw
# Must match CRSW_STAGING_PREFIX on the web VM. staging/_test was the
# laptop-era prefix (to 19 October 2026).
PROMOTER_STAGING_PREFIX=staging
# Optional limits (bytes); blank = unlimited
PROMOTER_MAX_OBJECT_BYTES=
PROMOTER_MAX_DEPOSIT_BYTES=
# Who may deposit where: * (anyone, any strand) or JSON {"k1078591": ["rs2"], "*": ["rs1"]}
PROMOTER_AUTHORISED=*
PROMOTER_LOG_PATH=promoter.log
# Each run's log is also written to the bucket, one object per run under
# this prefix (the audit trail; `python -m promoter audit` reads it).
# Blank disables.
PROMOTER_AUDIT_PREFIX=audit/promoter
# After a run that promoted or rewrote a record, the index of every record
# in place is rewritten under this prefix (datasets.jsonl and
# datasets.parquet; `python -m promoter index` rebuilds it by hand).
# Blank disables it, and with it embeddings and passages.
PROMOTER_INDEX_PREFIX=index
# The KCL LLM platform, for the embeddings behind meaning-based search.
# Set URL and key both or neither. A run that rewrites the index then
# also refreshes embeddings.parquet; `python -m promoter index --embed`
# does it by hand. Use a project key on the VM, not a personal one.
PROMOTER_LLM_BASE_URL=
PROMOTER_LLM_API_KEY=
# Each function is switched off by blanking its model name. This is an
# alias on the platform; the stored vectors are keyed to the backend it
# resolves to (GET /models), so a backend swapped behind the same alias
# re-embeds everything on the next run, with embed_model_changed on the trail.
# arc:embed (Qwen3-Embedding, text only) on both VMs since 16 October
# 2026; must match CRSW_LLM_EMBED_MODEL. Documents are embedded bare; the
# web puts the model's instruction on the question only.
PROMOTER_LLM_EMBED_MODEL=arc:embed
# Vectors are cut to this many numbers and stored at half precision
# (0 = the model's full length). Changing it re-embeds everything.
PROMOTER_LLM_EMBED_DIMS=1024
# Which sensitivities may be sent to the platform (comma-separated, from
# green,amber). Only record metadata (title, abstract, subject terms,
# source note) is sent for the dataset index; with passages on (below) it
# also governs whose file contents are read. Green only until the Centre
# allows amber.
PROMOTER_LLM_SENSITIVITIES=green
# Searching inside documents (finding-and-reuse.md §7). 1 = after a
# promotion, read the dataset's text-bearing files (plain text, Markdown,
# PDF text layer, Word), split them into passages and embed those under
# index/passages/. Off by default. `python -m promoter passages` rebuilds.
PROMOTER_PASSAGES=0
# Files over this size are skipped; the walk stops at this many passages
# per dataset (both counted in the log).
PROMOTER_PASSAGES_MAX_FILE_BYTES=52428800
PROMOTER_PASSAGES_MAX_PER_DATASET=20000
# How a file is cut: passages of this many words, each starting this many
# before the last ended. 150/30 since 16 October 2026, chosen by the probe
# in docs/web-deposit/passage-length-handoff.md (a 350-word passage mixed
# five treaty clauses into one vector; at 150 the right clause scored 0.54
# on its own sentence instead of 0.36). Every row records the layout it was
# cut under, so changing either value re-splits and re-embeds every file on
# the next `python -m promoter passages`.
PROMOTER_PASSAGE_WORDS=150
PROMOTER_PASSAGE_OVERLAP=30
# Datasets whose contents must never be indexed: identifiers or prefixes
# of them, comma-separated (e.g. rs1/oral, rs2/csac/amber/1_interim/x).
PROMOTER_PASSAGES_EXCLUDE=
