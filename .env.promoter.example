# Promoter configuration. Copy to .env.promoter (gitignored) and fill in.
# This key can write to the dataset prefixes; it must NEVER be given to
# the web service, and this file must never be present on the web VM.
PROMOTER_S3_ENDPOINT=https://rgw.ceph.er.kcl.ac.uk
PROMOTER_S3_ACCESS_KEY=
PROMOTER_S3_SECRET_KEY=
PROMOTER_S3_BUCKET=crsw
PROMOTER_STAGING_PREFIX=staging/_test
# Optional limits (bytes); blank = unlimited
PROMOTER_MAX_OBJECT_BYTES=
PROMOTER_MAX_DEPOSIT_BYTES=
# Who may deposit where: * (anyone, any strand) or JSON {"k1078591": ["rs2"], "*": ["rs1"]}
PROMOTER_AUTHORISED=*
PROMOTER_LOG_PATH=promoter.log
# Each run's log is also written to the bucket, one object per run under
# this prefix (the audit trail; `python -m promoter audit` reads it).
# Blank disables.
PROMOTER_AUDIT_PREFIX=audit/promoter
